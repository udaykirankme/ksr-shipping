generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shipment {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tracking_id      String                  @unique @db.VarChar(30)
  official_tracking_id String?              @unique @db.VarChar(100)
  tracking_type    String                  @db.VarChar(10)
  shipment_type    String                  @default("Domestic") @db.VarChar(20)
  courier          String?                 @db.VarChar(50)
  service          String?                 @db.VarChar(50)
  service_through  String?                 @db.VarChar(50)
  
  sender_name      String?                 @db.VarChar(100)
  sender_phone     String?                 @db.VarChar(20)
  sender_email     String?                 @db.VarChar(150)
  sender_address   String?                 @db.VarChar(255)
  sender_city      String?                 @db.VarChar(100)
  sender_state     String?                 @db.VarChar(100)
  sender_pincode   String?                 @db.VarChar(20)
  sender_country   String?                 @db.VarChar(100)
  
  receiver_name    String?                 @db.VarChar(100)
  receiver_phone   String?                 @db.VarChar(20)
  receiver_email   String?                 @db.VarChar(150)
  receiver_address String?                 @db.VarChar(255)
  receiver_city    String?                 @db.VarChar(100)
  receiver_state   String?                 @db.VarChar(100)
  receiver_pincode String?                 @db.VarChar(20)
  receiver_country String?                 @db.VarChar(100)
  
  origin           String?                 @db.VarChar(150)
  destination      String?                 @db.VarChar(150)
  
  weight           Float?
  description      String?
  num_packages     Int?                    @default(1)
  
  paid_amount      Float?                  @default(0)
  received_amount  Float?                  @default(0)
  profit           Float?                  @default(0)
  
  current_status   String                  @default("Shipment Created") @db.VarChar(30)
  current_location String?                 @db.VarChar(150)
  booked_date      DateTime                @default(now()) @db.Timestamp(6)
  estimated_delivery DateTime?             @db.Date
  delivered_at     DateTime?               @db.Timestamp(6)
  internal_notes   String?
  customer_update  String?
  
  is_active        Boolean                 @default(true)
  version          Int                     @default(1)
  
  created_at       DateTime                @default(now()) @db.Timestamp(6)
  updated_at       DateTime                @updatedAt @db.Timestamp(6)
  history          ShipmentStatusHistory[]

  @@index([tracking_id])
  @@index([official_tracking_id])
  @@index([booked_date])
  @@index([current_status])
  @@index([sender_phone])
  @@index([receiver_phone])

  @@map("shipments")
}

model ShipmentStatusHistory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id String    @db.Uuid
  status      String    @db.VarChar(30)
  location    String?   @db.VarChar(150)
  occurred_at DateTime  @db.Timestamp(6)
  note        String?
  updated_by  String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  shipment    Shipment   @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  admin_user  AdminUser? @relation(fields: [updated_by], references: [id])

  @@map("shipment_status_history")
}

model QuotationRequest {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id                String?   @unique @db.VarChar(30)
  name                    String    @db.VarChar(100)
  phone                   String    @db.VarChar(20)
  email                   String?   @db.VarChar(150)
  pickup_location         String?   @db.VarChar(150)
  drop_location           String?   @db.VarChar(150)
  package_type            String?   @db.VarChar(50)
  approx_weight           String?   @db.VarChar(30)
  urgency                 String?   @db.VarChar(30)
  notes                   String?
  
  preferred_courier       String?   @db.VarChar(50)
  preferred_service       String?   @db.VarChar(50)
  package_description     String?
  additional_requirements String?
  internal_notes          String?
  
  status                  String    @default("New") @db.VarChar(30)
  
  expires_at              DateTime? @db.Timestamp(6)
  
  version                 Int       @default(1)
  is_starred              Boolean   @default(false)
  opened_at               DateTime? @db.Timestamp(6)
  
  created_at              DateTime  @default(now()) @db.Timestamp(6)
  updated_at              DateTime  @updatedAt @db.Timestamp(6)

  history                 QuoteStatusHistory[]

  @@index([quote_id])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([created_at])

  @@map("quotation_requests")
}

model QuoteStatusHistory {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_request_id String    @db.Uuid
  status           String    @db.VarChar(30)
  occurred_at      DateTime  @db.Timestamp(6)
  note             String?
  updated_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamp(6)

  quote_request    QuotationRequest @relation(fields: [quote_request_id], references: [id], onDelete: Cascade)
  admin_user       AdminUser?       @relation(fields: [updated_by], references: [id])

  @@map("quote_status_history")
}

model ContactSubmission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id   String?   @unique @db.VarChar(30)
  name         String    @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(150)
  subject      String?   @db.VarChar(150)
  message      String
  status       String    @default("new") @db.VarChar(20)
  responded    Boolean   @default(false)
  responded_at DateTime? @db.Timestamp(6)
  is_starred   Boolean   @default(false)
  opened_at    DateTime? @db.Timestamp(6)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@index([contact_id])
  @@index([email])
  @@index([phone])

  @@map("contact_submissions")
}

enum NotificationType {
  QUOTE_REQUEST
  CONTACT_MESSAGE
  SYSTEM_ALERT
}

model Notification {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              NotificationType
  title             String           @db.VarChar(150)
  message           String
  related_entity_id String?          @db.Uuid
  target_url        String?          @db.VarChar(255)
  read_at           DateTime?        @db.Timestamp(6)
  is_starred        Boolean          @default(false)
  created_at        DateTime         @default(now()) @db.Timestamp(6)

  @@index([type])
  @@index([created_at])

  @@map("notifications")
}

model AdminUser {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String                  @unique @db.VarChar(50)
  password_hash String                  @db.VarChar(255)
  full_name     String?                 @db.VarChar(100)
  email         String?                 @unique @db.VarChar(150)
  mobile_number String?                 @db.VarChar(20)
  role          String                  @default("admin") @db.VarChar(20)
  created_at    DateTime                @default(now()) @db.Timestamp(6)
  last_login_at DateTime?               @db.Timestamp(6)
  
  shipment_history ShipmentStatusHistory[]
  quote_history    QuoteStatusHistory[]

  @@map("admin_users")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  type        String   @default("string") @db.VarChar(20)
  is_secret   Boolean  @default(false)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("system_settings")
}

model Service {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @unique @db.VarChar(100)
  slug          String    @unique @db.VarChar(100)
  description   String?
  display_order Int       @default(0)
  is_enabled    Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@map("services")
}

model ServiceThrough {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @unique @db.VarChar(100)
  slug          String    @unique @db.VarChar(100)
  display_order Int       @default(0)
  is_enabled    Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@map("service_through")
}

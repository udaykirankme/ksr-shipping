{
  "name": "ksr-shipping",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/*",
    "database"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w server/api\"",
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently \"npm run start -w apps/web\" \"npm run start -w server/api\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "jimp": "^0.16.1"
  }
}

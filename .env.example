# Local development (matches docker-compose.yml)
DATABASE_URL="postgresql://ksr_user:ksr_password@localhost:5432/ksr_db"
JWT_SECRET="change-me-in-production"

# Public site URL (required for SEO canonical URLs and metadata)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Optional legacy alias
# Local development (matches docker-compose.yml)
DATABASE_URL="postgresql://ksr_user:ksr_password@localhost:5432/ksr_db"
JWT_SECRET="change-me-in-production"

# Public site URL (required for SEO canonical URLs and metadata)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Optional legacy alias
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

DELHIVERY_B2C_API_URL=https://track.delhivery.com/api/v1/packages/json/
DELHIVERY_B2B_API_URL=https://ltl-clients-api.delhivery.com/lrn/track

# Delhivery Webhook Configuration
# Delhivery requires a custom header for authentication.
# Set the header name and expected secret value here.
DELHIVERY_B2C_WEBHOOK_HEADER_NAME=X-Delhivery-Auth
DELHIVERY_B2C_WEBHOOK_SECRET=your_b2c_webhook_secret_here

DELHIVERY_B2B_WEBHOOK_HEADER_NAME=X-Delhivery-Auth
DELHIVERY_B2B_WEBHOOK_SECRET=your_b2b_webhook_secret_here
